{
  "name": "waymark-cli",
  "version": "0.2.1",
  "description": "/plan 驱动的项目进度工作流可视化 CLI",
  "type": "module",
  "bin": {
    "waymark": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "waymark",
    "plan",
    "roadmap",
    "milestone",
    "workflow",
    "progress",
    "dag",
    "visualization",
    "project-management",
    "mcp",
    "ai-agent",
    "cli"
  ],
  "author": "zenjiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyber-teahouse/waymark.git"
  },
  "homepage": "https://github.com/cyber-teahouse/waymark#readme",
  "bugs": {
    "url": "https://github.com/cyber-teahouse/waymark/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.36.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
